# このファイルを .env という名前でコピーして使ってください。
# 「docker compose up --build」は自動で .env を読み込みます。

# ローカル/LAN内だけで使う場合は "http://localhost" のままでOKです(プレーンなHTTPで起動します)。
# インターネットに公開する場合は、スキームを付けずに実際のドメイン名だけを指定してください(例: DOMAIN=example.com)。
# ドメインを指定するとCaddyが自動でHTTPS化します。
# (ドメインのDNS AレコードをこのサーバーのグローバルIPに向け、
#  ルーターで80番・443番ポートをこのPCへ転送(ポートフォワーディング)しておく必要があります)
DOMAIN=http://localhost

# --- ベーシック認証(公開時は設定を強く推奨) ---
# 生成方法: docker run --rm caddy:2-alpine caddy hash-password --plaintext "パスワード"
# BASIC_AUTH_USER=admin
# BASIC_AUTH_HASH=$2a$14$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# クライアントから見守りサーバーへの接続先。
# 通常は空のままでOK(Caddy経由の同一オリジン接続を自動で使う)。
VITE_SOCKET_URL=

# --- AWS Cognito / IoT Core / 履歴API(Role C仕様書 Step 1/3/5) ---
# 【重要】ここに書いてよいのは公開されても問題ない識別子(ユーザープール/
# クライアント/アイデンティティプールのID、エンドポイント、APIのURL)のみ。
# ログイン用のパスワード等の秘密情報は絶対にここに書かないこと
# (ログイン画面から人が都度入力する運用のため、書く必要が無い)。
# 下記は現在ご利用中の値です。値が変わった場合はここを書き換えてください。
VITE_AWS_REGION=ap-southeast-1
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_VOqJJhoce
VITE_COGNITO_CLIENT_ID=53cvlrgu3dgvcs6ur64c735on6
VITE_COGNITO_IDENTITY_POOL_ID=ap-southeast-1:210ac09d-2d6a-47bd-b37c-6a66c7fcd2fa
VITE_IOT_ENDPOINT=a3evuy0mh0c3lq-ats.iot.ap-southeast-1.amazonaws.com
VITE_HISTORY_API_URL=https://mdaiocmem7.execute-api.ap-southeast-1.amazonaws.com/history
